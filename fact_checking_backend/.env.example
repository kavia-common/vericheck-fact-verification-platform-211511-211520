# Application
APP_NAME=VeriCheck Fact Checking API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vericheck

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_MIN=1440

# CORS/WS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Optional Integrations
GSC_API_KEY=

# Processing
PROCESSING_POLL_INTERVAL_MS=300
