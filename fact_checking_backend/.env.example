# Application
APP_NAME=VeriCheck Fact Checking API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# JWT
JWT_SECRET=please_change_me
JWT_EXPIRES_MIN=1440

# CORS
CORS_ORIGINS=*
WS_ALLOWED_ORIGINS=*

# MongoDB
# Option A: Provide a full URI (no trailing comma in hosts!)
# Example single host:
# MONGO_URI=mongodb://localhost:27017
# Example replica set (no trailing comma):
# MONGO_URI=mongodb://host1:27017,host2:27017,host3:27017/?replicaSet=rs0
# AND set MONGO_DB
MONGO_URI=
MONGO_DB=vericheck

# Option B: Let the app build the URI from discrete values:
# For multiple hosts separate by comma, but do NOT end with a trailing comma.
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USER=
# MONGO_PASSWORD=
# Optional additional params without leading '?', e.g. retryWrites=true&w=majority
# MONGO_PARAMS=
